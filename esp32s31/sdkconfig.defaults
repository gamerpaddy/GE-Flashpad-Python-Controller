# ESP32-S31-Function-CoreBoard-1 (ESP32-S31-WROOM-3, 16 MB flash, 16 MB PSRAM) - ESP-IDF v6.1

# ---- flash / partitions
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# ---- console: the board is plugged into the USB Serial/JTAG ("USB-DBG") port, which shows up as a COM port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ---- CPU / RTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# ---- PSRAM (16 MB on the module; octal, 200 MHz are the S31 defaults)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ---- Ethernet: RGMII to the on-board YT8531 + jumbo RX for the detector's ~4146 byte frames
# (CONFIG_ETH_RX_JUMBO needs idf_patches/0001-esp_eth-jumbo-rx.patch applied to ESP-IDF)
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_EMAC_RGMII_TX_CLK_SRC_APLL=y
CONFIG_ETH_DMA_BUFFER_SIZE=1600
CONFIG_ETH_DMA_RX_BUFFER_NUM=30
CONFIG_ETH_DMA_TX_BUFFER_NUM=10
CONFIG_ETH_RX_JUMBO=y
CONFIG_ETH_RX_JUMBO_MAX_FRAME=4300

# ---- lwIP
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# ---- HTTP server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256

# ---- TCP throughput for the 8 MiB frame download
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCP_ACCEPTMBOX_SIZE=8
